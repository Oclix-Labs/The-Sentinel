{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rwa-sentinel-alert-writer",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // Queue consumer config set per-env below.
  "env": {
    "staging": {
      "name": "rwa-sentinel-alert-writer-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "BASE_RPC_URL": "https://base-sepolia-rpc.publicnode.com",
        "ALERT_REGISTRY_ADDRESS": "0x0000000000000000000000000000000000000000"
      }
      // "queues": { "consumers": [{ "queue": "rwa-sentinel-alerts-staging", "max_batch_size": 10, "max_batch_timeout": 5 }] },
      // "d1_databases": [{ "binding": "DB", "database_id": "REPLACE_ME" }]
    },
    "production": {
      "name": "rwa-sentinel-alert-writer",
      "vars": {
        "ENVIRONMENT": "production",
        "BASE_RPC_URL": "https://mainnet.base.org",
        "ALERT_REGISTRY_ADDRESS": "0x0000000000000000000000000000000000000000"
      }
    }
  }
}
