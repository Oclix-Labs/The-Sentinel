{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rwa-sentinel-alert-writer",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // Before the first staging deploy:
  //   pnpm --filter @oclix/alert-writer exec wrangler d1 list            # confirm DB id
  //   pnpm --filter @oclix/alert-writer exec wrangler queues list        # confirm queue name
  //   pnpm --filter @oclix/alert-writer exec wrangler secret put TELEGRAM_BOT_TOKEN --env staging
  //   pnpm --filter @oclix/alert-writer exec wrangler secret put PUBLISHER_PRIVATE_KEY --env staging
  //
  // Then uncomment the binding blocks + d1 id / queue consumer below.

  "env": {
    "staging": {
      "name": "rwa-sentinel-alert-writer-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "BASE_RPC_URL": "https://sepolia.base.org",
        // D3 Sepolia deployment — see docs/ADDRESSES.md#alertregistry
        "ALERT_REGISTRY_ADDRESS": "0x79b5d74A301079c86D13eb71e2787852F403F876"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rwa-sentinel-staging",
          "database_id": "3431cd82-453d-4dba-8ae7-58dc2c55a7d6"
        }
      ],
      "queues": {
        "consumers": [
          {
            "queue": "rwa-sentinel-alerts-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3
          }
        ]
      }
    },
    "production": {
      "name": "rwa-sentinel-alert-writer",
      "vars": {
        "ENVIRONMENT": "production",
        "BASE_RPC_URL": "https://mainnet.base.org",
        // D5 Mainnet AlertRegistry — see docs/ADDRESSES.md#alertregistry.
        // ENVIRONMENT='production' routes the viem walletClient to `base` chain
        // (8453) via selectChain() in src/deliveries/onchain.ts.
        "ALERT_REGISTRY_ADDRESS": "0x79b5d74A301079c86D13eb71e2787852F403F876"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rwa-sentinel",
          "database_id": "9226b54f-d312-4710-8b33-296198d51873"
        }
      ],
      "queues": {
        "consumers": [
          {
            "queue": "rwa-sentinel-alerts-production",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3
          }
        ]
      }
    }
  }
}
