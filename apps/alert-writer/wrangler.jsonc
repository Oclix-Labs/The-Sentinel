{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rwa-sentinel-alert-writer",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // Before the first staging deploy:
  //   pnpm --filter @oclix/alert-writer exec wrangler d1 list            # confirm DB id
  //   pnpm --filter @oclix/alert-writer exec wrangler queues list        # confirm queue name
  //   pnpm --filter @oclix/alert-writer exec wrangler secret put TELEGRAM_BOT_TOKEN --env staging
  //   pnpm --filter @oclix/alert-writer exec wrangler secret put PUBLISHER_PRIVATE_KEY --env staging
  //
  // Then uncomment the binding blocks + d1 id / queue consumer below.

  "env": {
    "staging": {
      "name": "rwa-sentinel-alert-writer-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "BASE_RPC_URL": "https://mainnet.base.org",
        "ALERT_REGISTRY_ADDRESS": "0x0000000000000000000000000000000000000000"
      }
      // "d1_databases": [
      //   { "binding": "DB", "database_name": "rwa-sentinel-staging", "database_id": "REPLACE_ME" }
      // ],
      // "queues": {
      //   "consumers": [
      //     {
      //       "queue": "rwa-sentinel-alerts-staging",
      //       "max_batch_size": 10,
      //       "max_batch_timeout": 5,
      //       "max_retries": 3
      //     }
      //   ]
      // }
    },
    "production": {
      "name": "rwa-sentinel-alert-writer",
      "vars": {
        "ENVIRONMENT": "production",
        "BASE_RPC_URL": "https://mainnet.base.org",
        "ALERT_REGISTRY_ADDRESS": "0x0000000000000000000000000000000000000000"
      }
      // "d1_databases": [
      //   { "binding": "DB", "database_name": "rwa-sentinel", "database_id": "REPLACE_ME" }
      // ],
      // "queues": {
      //   "consumers": [
      //     {
      //       "queue": "rwa-sentinel-alerts-production",
      //       "max_batch_size": 10,
      //       "max_batch_timeout": 5,
      //       "max_retries": 3
      //     }
      //   ]
      // }
    }
  }
}
