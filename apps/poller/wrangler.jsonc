{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rwa-sentinel-poller",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],

  "triggers": {
    "crons": ["* * * * *"] // every minute
  },

  // Staging bindings are active (activated 2026-04-24 for D5 E2E). Production bindings
  // remain commented; create and paste IDs after the Base Mainnet contract deploy (D5+).
  //   pnpm --filter @oclix/poller exec wrangler d1 create rwa-sentinel
  //   pnpm --filter @oclix/poller exec wrangler kv namespace create PRICES_PROD
  //   pnpm --filter @oclix/poller exec wrangler queues create rwa-sentinel-alerts-production

  "env": {
    "staging": {
      "name": "rwa-sentinel-poller-staging",
      "vars": {
        // Oracle reads are Base Mainnet only — Sepolia has no Chainlink/Pyth/RedStone push feeds.
        // Only AlertRegistry contract deploy targets differ between envs (handled in alert-writer).
        "ENVIRONMENT": "staging",
        "BASE_RPC_URL": "https://mainnet.base.org"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rwa-sentinel-staging",
          "database_id": "3431cd82-453d-4dba-8ae7-58dc2c55a7d6",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "PRICES", "id": "4bb1d095719e45c28c8a055a9840ebae" }],
      "queues": {
        "producers": [{ "binding": "ALERTS", "queue": "rwa-sentinel-alerts-staging" }]
      }
    },
    "production": {
      "name": "rwa-sentinel-poller",
      "vars": {
        "ENVIRONMENT": "production",
        "BASE_RPC_URL": "https://mainnet.base.org"
      }
      // "d1_databases": [
      //   { "binding": "DB", "database_name": "rwa-sentinel", "database_id": "REPLACE_ME", "migrations_dir": "migrations" }
      // ],
      // "kv_namespaces": [
      //   { "binding": "PRICES", "id": "REPLACE_ME" }
      // ],
      // "queues": {
      //   "producers": [{ "binding": "ALERTS", "queue": "rwa-sentinel-alerts-production" }]
      // }
    }
  }
}
