# Base RPC endpoints — use a real provider (Alchemy/QuickNode/llamarpc) in practice.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Basescan API key for contract verification (forge --verify).
# Single key works for both networks via foundry.toml [etherscan] blocks.
BASESCAN_API_KEY=

# Hot wallet private key used ONLY for the AlertRegistry deploy transaction.
# Must be pre-funded on Base Sepolia (D3) and Base Mainnet (D5).
# Prefer forge's --keystore / --account flags for production deploys.
DEPLOYER_PRIVATE_KEY=

# Optional — if unset, deployer address is also the admin (and publisher).
# For mainnet, set this to the operator multisig / dedicated admin address.
ADMIN_ADDRESS=
