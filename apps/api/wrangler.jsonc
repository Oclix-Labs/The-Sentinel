{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rwa-sentinel-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // Staging + production bindings both active (production activated 2026-04-24 after D5
  // Mainnet AlertRegistry deploy). api is read-only on both D1 and KV; writers are poller
  // (prices, alerts) + alert-writer (alerts) + telegram-bot (subscriptions).

  "env": {
    "staging": {
      "name": "rwa-sentinel-api-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rwa-sentinel-staging",
          "database_id": "3431cd82-453d-4dba-8ae7-58dc2c55a7d6"
        }
      ],
      "kv_namespaces": [{ "binding": "PRICES", "id": "4bb1d095719e45c28c8a055a9840ebae" }]
    },
    "production": {
      "name": "rwa-sentinel-api",
      "vars": {
        "ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rwa-sentinel",
          "database_id": "9226b54f-d312-4710-8b33-296198d51873"
        }
      ],
      "kv_namespaces": [{ "binding": "PRICES", "id": "1f8928efdd5c4a3bbbeba58eb25ac32d" }]
    }
  }
}
