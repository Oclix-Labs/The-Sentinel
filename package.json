{
  "name": "the-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "The public watchdog for tokenized RWAs on Base — Oclix Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oclix-Labs/The-Sentinel.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "deploy:staging": "pnpm -r deploy:staging",
    "deploy:prod": "pnpm -r deploy:prod"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "typescript": "^5.6.0"
  }
